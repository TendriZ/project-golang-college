APP_NAME=db-students
APP_PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=db_students
DB_SSLMODE=disable
DB_MAX_CONNS=10

MONGO_URI=
MONGO_DATABASE=
MONGO_MAX_POOL=

JWT_SECRET=
JWT_ISSUER=db-students
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
ALLOWED_ORIGINS=http://localhost:5173

# --- background job (Modul 11) ---
# Relay dan worker memakai Redis yang sama. Tanpa variabel ini, nilai
# bawaan localhost:6379 / database 0 dipakai.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
WORKER_CONCURRENCY=5
# Mailer tiruan: delay tiap email dan interval kegagalan sementara
# (0 = tidak pernah gagal, 3 = setiap attempt ke-3 gagal).
MAILER_DELAY_MS=1500
MAILER_FAIL_EVERY=0
RELAY_INTERVAL_MS=1000
RELAY_BATCH=100
